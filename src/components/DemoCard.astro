---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
  demo: CollectionEntry<'demos'>;
}

const { demo } = Astro.props;
const { title, subtitle, description, tags } = demo.data;
---

<article
  class="card-hover relative flex h-full flex-col rounded-xl border border-border bg-card p-6"
  data-filter-item
  data-tags={tags.join('|')}
>
  <svg width="48" height="20" viewBox="0 0 48 20" fill="none" aria-hidden="true" class="text-accent-violet">
    <rect x="1" y="8" width="3" height="4" rx="1.5" fill="currentColor" opacity="0.5"></rect>
    <rect x="7" y="5" width="3" height="10" rx="1.5" fill="currentColor" opacity="0.7"></rect>
    <rect x="13" y="2" width="3" height="16" rx="1.5" fill="currentColor"></rect>
    <rect x="19" y="6" width="3" height="8" rx="1.5" fill="currentColor" opacity="0.7"></rect>
    <rect x="25" y="4" width="3" height="12" rx="1.5" fill="currentColor" opacity="0.85"></rect>
    <rect x="31" y="7" width="3" height="6" rx="1.5" fill="currentColor" opacity="0.6"></rect>
    <rect x="37" y="5" width="3" height="10" rx="1.5" fill="currentColor" opacity="0.75"></rect>
    <rect x="43" y="8" width="3" height="4" rx="1.5" fill="currentColor" opacity="0.5"></rect>
  </svg>
  <h3 class="mt-4 text-lg font-semibold leading-snug">
    <a href={`/demos/${demo.id}`} class="transition-colors after:absolute after:inset-0 hover:text-accent-violet">
      {title}
    </a>
  </h3>
  {subtitle && <p class="mt-0.5 text-sm text-accent-violet">{subtitle}</p>}
  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{description}</p>
  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Topics">
        {tags.map((tag) => (
          <li>
            <Tag label={tag} />
          </li>
        ))}
      </ul>
    )
  }
</article>
