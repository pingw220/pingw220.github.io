---
import { PROFILE_LINKS, type IconName } from '../config/site';
import { getLang, t } from '../i18n';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const ui = t(getLang(Astro.url));

// 24×24 stroke icons (Lucide-style) plus filled brand marks.
const ICONS: Record<IconName, { path: string; fill?: boolean }> = {
  scholar: { path: 'M12 3 1 9l11 6 9-4.9V17h2V9L12 3zm-7 10.2v4L12 21l7-3.8v-4L12 17l-7-3.8z', fill: true },
  github: {
    path: 'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.55v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.55A11.5 11.5 0 0 0 12 .5z',
    fill: true,
  },
  linkedin: {
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
    fill: true,
  },
  email: { path: 'M3 5h18v14H3zM3 6l9 7 9-7' },
  cv: { path: 'M14 3H6v18h12V7zM14 3v4h4M9 12h6M9 16h6' },
};
---

<ul class:list={['flex flex-wrap gap-2', className]} aria-label="Profiles and contact">
  {
    PROFILE_LINKS.map(({ label, key, href, icon }) => {
      const short = ui[key];
      const external = href.startsWith('http');
      const { path, fill } = ICONS[icon];
      return (
        <li>
          <a
            href={href}
            aria-label={label}
            class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-3.5 py-1.5 font-mono text-xs text-muted transition-colors hover:border-accent-violet/60 hover:text-foreground"
            {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              aria-hidden="true"
              {...(fill
                ? { fill: 'currentColor' }
                : { fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' })}
            >
              <path d={path} />
            </svg>
            {short}
          </a>
        </li>
      );
    })
  }
</ul>
