---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import { formatDate, getLang, localizePath } from '../i18n';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, date, tags } = post.data;

const lang = getLang(Astro.url);
const formatted = formatDate(date, lang);
---

<article
  class="card-hover relative rounded-xl border border-border bg-card p-6"
  data-filter-item
  data-tags={tags.join('|')}
>
  <time datetime={date.toISOString().slice(0, 10)} class="font-mono text-xs text-muted">{formatted}</time>
  <h3 class="mt-2 text-lg font-semibold leading-snug">
    <a href={localizePath(`/posts/${post.id}`, lang)} class="transition-colors after:absolute after:inset-0 hover:text-accent-violet">
      {title}
    </a>
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-muted">{description}</p>
  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Topics">
        {tags.map((tag) => (
          <li>
            <Tag label={tag} />
          </li>
        ))}
      </ul>
    )
  }
</article>
