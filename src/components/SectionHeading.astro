---
interface Props {
  eyebrow?: string;
  title: string;
  href?: string;
  linkLabel?: string;
}

const { eyebrow, title, href, linkLabel = 'View all' } = Astro.props;
---

<div class="mb-8 flex items-end justify-between gap-4">
  <div>
    {
      eyebrow && (
        <p class="mb-2 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-accent-violet">
          <span class="accent-rule inline-block h-px w-6" aria-hidden="true" />
          {eyebrow}
        </p>
      )
    }
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  </div>
  {
    href && (
      <a
        href={href}
        class="group shrink-0 text-sm text-muted transition-colors hover:text-accent-violet"
      >
        {linkLabel} <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    )
  }
</div>
