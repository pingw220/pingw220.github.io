---
interface Props {
  title: string;
  id?: string;
  href?: string;
  linkLabel?: string;
}

const { title, id, href, linkLabel = 'View all' } = Astro.props;
---

<div class="mb-6 flex items-baseline justify-between gap-4">
  <h2 {id} class="text-2xl font-semibold tracking-tight">
    <span class="mr-2 font-mono font-normal text-muted/50" aria-hidden="true">//</span>{title}
  </h2>
  {
    href && (
      <a href={href} class="group shrink-0 text-sm text-muted transition-colors hover:text-accent-violet">
        {linkLabel} <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    )
  }
</div>
