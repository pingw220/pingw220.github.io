---
import ProfileLinks from './ProfileLinks.astro';
import { SITE } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border/70 bg-surface/40">
  <div class="mx-auto flex max-w-5xl flex-col gap-5 px-5 py-8 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-muted">© {year} {SITE.name}</p>
    <ProfileLinks />
  </div>
</footer>
