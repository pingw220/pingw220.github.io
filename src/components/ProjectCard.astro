---
import Tag from './Tag.astro';
import type { Project } from '../i18n/content';
import { getLang, localizePath, t } from '../i18n';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const lang = getLang(Astro.url);
const ui = t(lang);
const { title, subtitle, description, year, status, category, tags, cover } = project.data;

const categoryLabels: Record<typeof category, string> = {
  research: ui['category.research'],
  engineering: ui['category.engineering'],
  experiment: ui['category.experiment'],
};

const categoryStyles: Record<typeof category, string> = {
  research: 'border-accent-violet/40 text-accent-violet',
  engineering: 'border-accent-gold/40 text-accent-gold',
  experiment: 'border-accent-blue/40 text-accent-blue',
};

const statusLabels: Record<typeof status, string> = {
  active: ui['pstatus.active'],
  completed: ui['pstatus.completed'],
  paused: ui['pstatus.paused'],
  archived: ui['pstatus.archived'],
};
---

<article
  class="card-hover relative flex h-full flex-col overflow-hidden rounded-xl border border-border bg-card"
  data-filter-item
  data-tags={tags.join('|')}
  data-year={String(year)}
  data-category={category}
>
  {cover && <img src={cover} alt="" class="aspect-[2/1] w-full object-cover" loading="lazy" />}
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <span class:list={['rounded-full border px-2.5 py-0.5 text-xs font-medium', categoryStyles[category]]}>
        {categoryLabels[category]}
      </span>
      <span class="font-mono text-xs text-muted">{year} · {statusLabels[status]}</span>
    </div>
    <h3 class="mt-3 text-lg font-semibold leading-snug">
      <a href={localizePath(`/projects/${project.slug}`, lang)} class="transition-colors after:absolute after:inset-0 hover:text-accent-violet">
        {title}
      </a>
    </h3>
    {subtitle && <p class="mt-0.5 text-sm text-accent-violet">{subtitle}</p>}
    <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{description}</p>
    {
      tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Topics">
          {tags.map((tag) => (
            <li>
              <Tag label={tag} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
