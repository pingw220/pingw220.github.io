---
/**
 * TV dramas as a living room: each country is a channel, and every series plays on its own
 * little retro TV set.
 */
import { groupItems, type LibraryItem } from '../../../config/library';
import { getLang, t, tr } from '../../../i18n';

interface Props {
  items: LibraryItem[];
}

const lang = getLang(Astro.url);
const ui = t(lang);
const { groups } = groupItems(Astro.props.items, lang);
const SETS = ['#e9a46a', '#7fb7be', '#e5989b', '#b5c99a', '#cdb4db', '#f6bd60'];
---

<div class="relative overflow-hidden rounded-3xl bg-[#2f4f4f] bg-[radial-gradient(rgba(255,255,255,0.06)_1.5px,transparent_2px)] bg-[length:22px_22px] p-4 text-[#fdf4e3] shadow-xl ring-1 ring-black/20 sm:p-8">
  {
    groups.map((g, gi) => (
      <section class:list={[gi > 0 && 'mt-12']}>
        <h3 class="mb-5 flex items-center gap-3">
          <span class="rounded-md bg-[#111] px-2.5 py-1 font-mono text-sm font-bold text-[#7CFC00] shadow-inner">CH {String(gi + 1).padStart(2, '0')}</span>
          <span class="text-lg font-bold">{g.title}</span>
          <span class="text-xs text-[#fdf4e3]/60">{g.list.length} 📺</span>
        </h3>
        <ul class="grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
          {g.list.map(({ item, index }, k) => (
            <li>
              <button type="button" data-open={index} class="group block w-full text-left">
                {/* Antenna */}
                <span class="relative mx-auto block h-6 w-16" aria-hidden="true">
                  <span class="absolute bottom-0 left-1/2 h-7 w-[2px] origin-bottom -translate-x-1/2 -rotate-[28deg] bg-[#2b2b33] transition group-hover:-rotate-[38deg]" />
                  <span class="absolute bottom-0 left-1/2 h-7 w-[2px] origin-bottom -translate-x-1/2 rotate-[28deg] bg-[#2b2b33] transition group-hover:rotate-[38deg]" />
                </span>
                {/* The TV set */}
                <span class="flex gap-2 rounded-2xl p-2.5 shadow-[0_8px_0_rgba(0,0,0,0.25)] transition group-hover:-translate-y-1" style={`background: ${SETS[(index + k) % SETS.length]}`}>
                  <span class="relative block aspect-[4/3] flex-1 overflow-hidden rounded-[18%/22%] bg-[#111] ring-4 ring-black/40">
                    {item.image ? (
                      <img src={item.image} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover object-top opacity-90 transition group-hover:opacity-100" />
                    ) : (
                      <span class="flex h-full items-center justify-center p-2 text-center text-xs font-bold">{tr(item.title, lang)}</span>
                    )}
                    <span class="pointer-events-none absolute inset-0 bg-[repeating-linear-gradient(transparent_0_2px,rgba(0,0,0,0.12)_2px_3px)]" aria-hidden="true" />
                    <span class="pointer-events-none absolute -left-1/4 -top-1/4 h-1/2 w-3/4 rotate-12 rounded-full bg-white/15 blur-md" aria-hidden="true" />
                  </span>
                  <span class="flex w-5 flex-col items-center justify-center gap-2" aria-hidden="true">
                    <span class="h-3.5 w-3.5 rounded-full bg-[#3a2a1a] ring-2 ring-black/20" />
                    <span class="h-3.5 w-3.5 rounded-full bg-[#3a2a1a] ring-2 ring-black/20" />
                    <span class="mt-1 h-1 w-3 rounded bg-black/30" />
                    <span class="h-1 w-3 rounded bg-black/30" />
                  </span>
                </span>
                {/* Legs */}
                <span class="mx-auto flex w-3/4 justify-between" aria-hidden="true">
                  <span class="h-3 w-1.5 rounded-b bg-[#3a2a1a]" />
                  <span class="h-3 w-1.5 rounded-b bg-[#3a2a1a]" />
                </span>
                <span class="mt-1 block text-center text-sm font-semibold leading-snug group-hover:text-[#ffd166]">{tr(item.title, lang)}</span>
                {item.subtitle && <span class="block text-center text-xs text-[#fdf4e3]/60">{tr(item.subtitle, lang)}{item.date && ` · ${item.date}`}</span>}
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <!-- The couch -->
  <div class="mx-auto mt-14 w-full max-w-md" aria-hidden="true">
    <div class="mx-6 h-8 rounded-t-2xl bg-[#d97b66]"></div>
    <div class="flex h-10 items-stretch">
      <span class="w-8 rounded-l-2xl bg-[#c4614d]"></span>
      <span class="flex flex-1 gap-1 bg-[#e08e78] p-1"><span class="flex-1 rounded-lg bg-[#e9a38f]"></span><span class="flex-1 rounded-lg bg-[#e9a38f]"></span></span>
      <span class="w-8 rounded-r-2xl bg-[#c4614d]"></span>
    </div>
    <p class="mt-2 text-center text-xs text-[#fdf4e3]/60">🛋️ {ui['int.lounge.couch']}</p>
  </div>
</div>
