---
/**
 * Sports as a hall of fame: a shiny trading card for each GOAT.
 */
import { coverOf, type LibraryItem } from '../../../config/library';
import { getLang, tr } from '../../../i18n';

interface Props {
  items: LibraryItem[];
}

const lang = getLang(Astro.url);
const SPORT: [RegExp, string][] = [
  [/table tennis|桌球/i, '🏓'],
  [/football|soccer|足球/i, '⚽'],
  [/tennis|網球/i, '🎾'],
  [/basketball|籃球/i, '🏀'],
];
const emojiOf = (item: LibraryItem) => SPORT.find(([re]) => re.test(tr(item.subtitle ?? '', 'en') + tr(item.subtitle ?? '', 'zh')))?.[1] ?? '🏅';
---

<div class="relative overflow-hidden rounded-3xl bg-[#0f1630] bg-[radial-gradient(ellipse_at_top,rgba(255,209,102,0.18),transparent_60%)] p-5 text-[#fdf4e3] shadow-xl ring-1 ring-black/30 sm:p-10">
  <p class="mb-8 text-center text-sm font-bold uppercase tracking-[0.35em] text-[#ffd166]">🐐 Hall of GOATs 🐐</p>
  <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      (Astro.props.items ?? []).map((item, index) => (
        <li class="[perspective:900px]">
          <button type="button" data-open={index} class="group block w-full text-left transition duration-500 [transform-style:preserve-3d] hover:[transform:rotateY(-10deg)_rotateX(4deg)]">
            {/* Holographic border */}
            <span class="block rounded-2xl bg-[conic-gradient(from_180deg,#ffd166,#f15bb5,#3fa7d6,#b5e48c,#ffd166)] p-[3px] shadow-[0_14px_30px_-10px_rgba(0,0,0,0.8)]">
              <span class="relative block overflow-hidden rounded-[14px] bg-[#1f2a55]">
                <span class="absolute left-2 top-2 z-10 rounded-full bg-[#ffd166] px-2 py-0.5 text-[10px] font-black uppercase tracking-widest text-[#1f2a55] shadow">GOAT</span>
                <span class="absolute right-2 top-2 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-xl shadow" aria-hidden="true">{emojiOf(item)}</span>
                {coverOf(item) && <img src={coverOf(item)} alt="" loading="lazy" decoding="async" class="aspect-[3/4] w-full object-cover object-top" />}
                <span class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-transparent via-white/25 to-transparent opacity-0 transition duration-500 group-hover:opacity-100" aria-hidden="true" />
                <span class="block border-t-2 border-[#ffd166] bg-gradient-to-b from-[#1f2a55] to-[#141c3d] px-4 py-3">
                  <span class="block text-lg font-black leading-tight">{tr(item.title, lang)}</span>
                  {item.subtitle && <span class="block text-xs text-[#fdf4e3]/70">{tr(item.subtitle, lang)}</span>}
                </span>
              </span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>
</div>
