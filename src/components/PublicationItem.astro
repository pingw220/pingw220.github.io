---
import type { CollectionEntry } from 'astro:content';
import { SITE } from '../config/site';
import { getLang, localizePath, t } from '../i18n';

/** Compact, academic-style publication entry (home page). The full card is PublicationCard. */
interface Props {
  publication: CollectionEntry<'publications'>;
}

const { title, authors, venue, year, links } = Astro.props.publication.data;
const lang = getLang(Astro.url);
const ui = t(lang);

const linkEntries = [
  { label: ui['pub.short.paper'], href: links.paper },
  { label: ui['pub.short.code'], href: links.code },
  { label: ui['pub.short.demo'], href: links.demo },
  { label: ui['pub.short.project'], href: links.project && localizePath(links.project, lang) },
].filter((l): l is { label: string; href: string } => Boolean(l.href));

const titleHref = links.paper ?? (links.project && localizePath(links.project, lang));
---

<article class="border-l-2 border-accent-violet/50 py-1 pl-5">
  <h3 class="font-semibold leading-snug text-foreground">
    {titleHref ? <a href={titleHref} class="transition-colors hover:text-accent-violet">{title}</a> : title}
  </h3>
  <p class="mt-1.5 text-sm leading-relaxed text-muted">
    {
      authors.map((author, i) => (
        <>
          <span class:list={[author === SITE.name && 'font-semibold text-foreground']}>{author}</span>
          {i < authors.length - 1 && ', '}
        </>
      ))
    }
  </p>
  <p class="mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
    <span class="italic text-foreground/90">{venue}</span>
    <span class="font-mono text-xs text-muted">{year}</span>
    {
      linkEntries.map(({ label, href }) => (
        <a href={href} class="font-mono text-xs text-accent-blue transition-colors hover:text-foreground">
          [{label}]
        </a>
      ))
    }
  </p>
</article>
