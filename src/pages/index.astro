---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PublicationItem from '../components/PublicationItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import GlobalReach from '../components/GlobalReach.astro';
import { LINKS, SITE } from '../config/site';
import { NEWS } from '../config/news';

const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);

const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 4);
---

<BaseLayout person>
  <div class="mx-auto max-w-4xl space-y-20 px-5 pt-14 sm:pt-20">
    <!-- Intro -->
    <section aria-labelledby="intro" class="grid gap-10 md:grid-cols-[1fr_15rem] md:items-start">
      <div>
        <h1 id="intro" class="text-4xl font-bold tracking-tight sm:text-5xl">
          {SITE.name}
          <span lang="zh" class="ml-2 align-baseline text-2xl font-normal text-muted sm:text-3xl">{SITE.nameZh}</span>
        </h1>
        <p class="mt-3 font-mono text-sm text-muted">// {SITE.role}</p>

        <div class="rich mt-7 space-y-4 leading-relaxed text-foreground/85">
          <p>
            I am an undergraduate in the <a href={LINKS.allenSchool}>Paul G. Allen School of Computer Science &
            Engineering</a> at the University of Washington, where I am advised by Prof.{' '}
            <a href={LINKS.noahSmith}>Noah A. Smith</a> in <a href={LINKS.noahsArk}>Noah’s ARK</a>. Since May
            2026, I have also been a student researcher in the <a href={LINKS.ntuMusicAi}>Music and AI Lab</a> at
            National Taiwan University, advised by Prof. <a href={LINKS.yiHsuanYang}>Yi-Hsuan Yang</a>.
          </p>
          <p>
            I work on AI for music. I study how to turn audio into sheet music people can read and play, how to
            evaluate those transcriptions in ways that match human judgment, and how to post-train music
            generation models with better reward signals. More broadly, I am interested in music information
            retrieval, symbolic music modeling, audio representation learning, and multimodal learning.
          </p>
        </div>

        <ProfileLinks class="mt-7" />
      </div>

      <img
        src={SITE.portrait}
        alt={`Portrait of ${SITE.name}`}
        width="240"
        height="240"
        class="mx-auto w-48 rounded-2xl border border-border object-cover shadow-lg shadow-black/20 md:mx-0 md:mt-2 md:w-60"
      />
    </section>

    <!-- News -->
    <section aria-labelledby="news">
      <SectionHeading id="news" title="News" />
      <ul class="rich divide-y divide-border/60 rounded-xl border border-border bg-card/50">
        {
          NEWS.map((item) => (
            <li class="grid gap-1 px-5 py-3.5 sm:grid-cols-[5rem_1fr] sm:gap-4">
              <span class="pt-0.5 font-mono text-xs text-muted">{item.date}</span>
              <p class="text-sm leading-relaxed text-foreground/85">
                <Fragment set:html={item.html} />
                {item.links?.map((link) => (
                  <>
                    {' '}[<a href={link.href}>{link.label}</a>]
                  </>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Publications -->
    <section aria-labelledby="publications">
      <SectionHeading id="publications" title="Publications" href="/publications" linkLabel="All publications" />
      <div class="space-y-6">
        {publications.map((publication) => <PublicationItem {publication} />)}
      </div>
    </section>

    <!-- Projects -->
    <section aria-labelledby="projects">
      <SectionHeading id="projects" title="Projects" href="/projects" linkLabel="All projects" />
      <div class="grid gap-5 sm:grid-cols-2">
        {projects.map((project) => <ProjectCard {project} />)}
      </div>
    </section>

    <GlobalReach />
  </div>
</BaseLayout>
