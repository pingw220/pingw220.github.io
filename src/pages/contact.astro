---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROFILE_LINKS, SITE } from '../config/site';

const notes: Record<string, string> = {
  Email: SITE.email,
  'Google Scholar': 'Publications and citations',
  GitHub: 'Research code and open-source projects',
  LinkedIn: 'Professional background',
  CV: 'PDF',
};
---

<BaseLayout
  title="Contact"
  description="Contact Ping Wang about AI for music research: music transcription, evaluation, generation, and collaborations."
>
  <div class="mx-auto max-w-3xl px-5 py-14 sm:py-20">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Contact</h1>
    <p class="mt-4 max-w-2xl leading-relaxed text-muted">
      The best way to reach me is by email at
      <a href={`mailto:${SITE.email}`} class="text-accent-blue underline underline-offset-4 hover:text-foreground">{SITE.email}</a>.
      I'm happy to talk about music transcription and its evaluation, music generation and post-training, or
      possible collaborations.
    </p>

    <ul class="mt-10 space-y-3">
      {
        PROFILE_LINKS.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="card-hover flex items-baseline justify-between gap-4 rounded-xl border border-border bg-card p-5"
              {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="font-semibold text-accent-violet">{label}</span>
              <span class="truncate text-sm text-muted">{notes[label]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
