---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <div class="mx-auto flex max-w-3xl flex-col items-start px-5 py-24">
    <p class="font-mono text-sm text-accent-violet">404 · silence detected</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">This page doesn't exist</h1>
    <p class="mt-4 text-muted">The note you're looking for was never played — or it moved somewhere else.</p>
    <div class="mt-8">
      <Button href="/">Back to home</Button>
    </div>
  </div>
</BaseLayout>
