---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { t } from '../i18n';

// GitHub Pages serves one 404 page for every missing URL, so it shows both languages.
const en = t('en');
const zh = t('zh');
---

<BaseLayout title="Page not found · 找不到頁面" description="This page does not exist.">
  <div class="mx-auto flex max-w-3xl flex-col items-start px-5 py-24">
    <p class="font-mono text-sm text-accent-violet">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{en['notFound.title']}</h1>
    <p class="mt-4 text-muted">{en['notFound.body']}</p>
    <p lang="zh-Hant-TW" class="mt-6 text-xl font-semibold">{zh['notFound.title']}</p>
    <p lang="zh-Hant-TW" class="mt-2 text-muted">{zh['notFound.body']}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/">{en['notFound.home']}</Button>
      <Button href="/zh/" variant="secondary">{zh['notFound.home']}</Button>
    </div>
  </div>
</BaseLayout>
