---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FilterBar from '../../components/FilterBar';

const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year);

const tags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
const years = [...new Set(projects.map((p) => String(p.data.year)))].sort().reverse();

const filterGroups = [
  { key: 'category', label: 'Type', options: ['research', 'engineering', 'experiment'] },
  { key: 'tags', label: 'Topic', options: tags },
  { key: 'year', label: 'Year', options: years },
];
---

<BaseLayout
  title="Projects"
  description="Research and engineering projects by Ping Wang: music transcription, evaluation, generation, and audio machine learning."
>
  <div class="mx-auto max-w-5xl px-5 py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Projects</h1>
    <p class="mt-3 max-w-2xl text-muted">
      Research systems, engineering work, and smaller experiments. Click a card for details.
    </p>

    <div class="mt-10">
      <FilterBar client:load groups={filterGroups} targetSelector="#project-list" />
    </div>

    <div id="project-list" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard {project} />)}
    </div>
  </div>
</BaseLayout>
