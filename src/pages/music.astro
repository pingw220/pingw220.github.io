---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { MUSIC_SECTIONS } from '../config/music';

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="Music"
  description="Cello performances by Ping Wang: solo, chamber music, and orchestra recordings from concerts and the National Student Competition of Music."
>
  <div class="mx-auto max-w-5xl px-5 py-14 sm:py-20">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Music</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted">
      I play the cello. These are recordings of my performances — solo, chamber music, and orchestra — from
      concerts and the National Student Competition of Music.
    </p>

    {
      MUSIC_SECTIONS.map(({ title, performances }) => (
        <section class="mt-14" aria-label={title}>
          <SectionHeading {title} />
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {performances.map((p) => (
              <li class="flex flex-col overflow-hidden rounded-xl border border-border bg-card">
                <div class="yt-lite relative aspect-video bg-black" data-id={p.id} data-title={p.title}>
                  <button type="button" class="group absolute inset-0 h-full w-full" aria-label={`Play: ${p.title}`}>
                    <img
                      src={`https://i.ytimg.com/vi/${p.id}/hqdefault.jpg`}
                      alt=""
                      loading="lazy"
                      class="h-full w-full object-cover opacity-90 transition-opacity group-hover:opacity-100"
                    />
                    <span class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                      <span class="flex h-12 w-16 items-center justify-center rounded-xl bg-black/70 transition-colors group-hover:bg-[#ff0033]">
                        <svg class="ml-0.5 h-5 w-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M8 5v14l11-7z" />
                        </svg>
                      </span>
                    </span>
                  </button>
                </div>
                <div class="flex flex-1 flex-col p-4">
                  <h3 class="font-semibold leading-snug text-foreground">{p.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{p.detail}</p>
                  <p class="mt-auto flex flex-wrap items-center gap-2 pt-3 text-xs">
                    {p.award && (
                      <span class="rounded-full border border-accent-gold/50 px-2 py-0.5 font-medium text-accent-gold">
                        {p.award}
                      </span>
                    )}
                    {p.date && <span class="font-mono text-muted">{formatDate(p.date)}</span>}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  // Load the YouTube player only when a video is clicked (privacy-enhanced domain).
  document.querySelectorAll<HTMLElement>('.yt-lite').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(box.dataset.id ?? '')}?autoplay=1&rel=0`;
      iframe.title = box.dataset.title ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full';
      box.replaceChildren(iframe);
    });
  });
</script>
