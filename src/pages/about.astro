---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import { LINKS, SITE } from '../config/site';
import {
  EDUCATION,
  INDUSTRY_EXPERIENCE,
  RESEARCH_EXPERIENCE,
  RESEARCH_INTERESTS,
  SKILLS,
  type Entry,
} from '../config/cv';

const sections: { id: string; title: string; entries: Entry[] }[] = [
  { id: 'education', title: 'Education', entries: EDUCATION },
  { id: 'research', title: 'Research experience', entries: RESEARCH_EXPERIENCE },
  { id: 'industry', title: 'Industry experience', entries: INDUSTRY_EXPERIENCE },
];
---

<BaseLayout
  title="About"
  description="About Ping Wang, an undergraduate researcher at the University of Washington working on AI for music, advised by Prof. Noah A. Smith (UW) and Prof. Yi-Hsuan Yang (NTU)."
>
  <div class="mx-auto max-w-4xl px-5 py-14 sm:py-20">
    <!-- Intro -->
    <div class="grid gap-8 sm:grid-cols-[10rem_1fr] sm:items-start">
      <img
        src={SITE.portrait}
        alt={`Portrait of ${SITE.name}`}
        width="160"
        height="160"
        class="h-40 w-40 rounded-2xl border border-border object-cover"
      />
      <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">About</h1>
        <p class="mt-2 font-mono text-sm text-muted">// {SITE.role}</p>
        <div class="rich mt-5 space-y-4 leading-relaxed text-foreground/85">
          <p>
            I'm {SITE.name} (<span lang="zh">{SITE.nameZh}</span>), an undergraduate studying computer science at
            the <a href={LINKS.allenSchool}>Paul G. Allen School</a>, University of Washington. I do research in
            AI for music with Prof. <a href={LINKS.noahSmith}>Noah A. Smith</a> at UW and, since May 2026, with
            Prof. <a href={LINKS.yiHsuanYang}>Yi-Hsuan Yang</a> in the{' '}
            <a href={LINKS.ntuMusicAi}>Music and AI Lab</a> at National Taiwan University.
          </p>
          <p>
            My work spans the path from audio to notation and back. I build systems that transcribe songs into
            lead sheets, design evaluations of music transcription that reflect how people actually read and hear
            the results, and post-train text-to-music models with rubric-based rewards. I am also working on
            lyrics-conditioned song generation.
          </p>
        </div>
        <ProfileLinks class="mt-6" />
      </div>
    </div>

    <!-- Research interests -->
    <section class="mt-16" aria-labelledby="interests">
      <SectionHeading id="interests" title="Research interests" />
      <ul class="flex flex-wrap gap-2">
        {
          RESEARCH_INTERESTS.map((interest) => (
            <li class="rounded-full border border-border bg-card/60 px-3 py-1 text-sm text-foreground/85">{interest}</li>
          ))
        }
      </ul>
    </section>

    <!-- Education & experience -->
    {
      sections.map(({ id, title, entries }) => (
        <section class="mt-14" aria-labelledby={id}>
          <SectionHeading {id} {title} />
          <ol class="space-y-8">
            {entries.map((entry) => (
              <li class="rich">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <h3 class="font-semibold text-foreground">
                    {entry.orgHref ? <a href={entry.orgHref}>{entry.org}</a> : entry.org}
                  </h3>
                  <span class="text-sm text-muted">{entry.place}</span>
                </div>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 text-sm">
                  <p class="italic text-foreground/80">
                    {entry.title}
                    {entry.advisor && (
                      <>
                        {' '}— Advisor: <a href={entry.advisor.href}>{entry.advisor.name}</a>
                      </>
                    )}
                  </p>
                  <span class="font-mono text-xs text-muted">{entry.dates}</span>
                </div>
                {entry.points && (
                  <ul class="mt-3 space-y-2 border-l border-border pl-4 text-sm leading-relaxed text-muted">
                    {entry.points.map((point) => (
                      <li>
                        <span class="font-medium text-foreground">
                          {point.href ? <a href={point.href}>{point.title}</a> : point.title}
                        </span>
                        : {point.text}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <!-- Skills -->
    <section class="mt-14" aria-labelledby="skills">
      <SectionHeading id="skills" title="Skills" />
      <dl class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-[10rem_1fr]">
        {
          SKILLS.map(({ area, items }) => (
            <>
              <dt class="font-medium text-foreground">{area}</dt>
              <dd class="leading-relaxed text-muted">{items}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <!-- CV -->
    <section class="mt-14 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-border bg-card/60 p-6" aria-label="Download CV">
      <p class="text-sm text-muted">The full version, with coursework and details, is in my CV.</p>
      <Button href={SITE.cv}>Download CV (PDF)</Button>
    </section>
  </div>
</BaseLayout>
