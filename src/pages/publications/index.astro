---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import FilterBar from '../../components/FilterBar';
import { SITE } from '../../config/site';

const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);

const tags = [...new Set(publications.flatMap((p) => p.data.tags))].sort();
const years = [...new Set(publications.map((p) => String(p.data.year)))].sort().reverse();
const statuses = [...new Set(publications.map((p) => p.data.status))];

const filterGroups = [
  { key: 'tags', label: 'Topic', options: tags },
  { key: 'year', label: 'Year', options: years },
  { key: 'status', label: 'Status', options: statuses },
];
---

<BaseLayout
  title="Publications"
  description="Publications by Ping Wang on automatic music transcription, its evaluation, and post-training for music generation."
>
  <div class="mx-auto max-w-3xl px-5 py-16">
    <header class="border-b border-border pb-6">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Publications</h1>
      <p class="mt-3 leading-relaxed text-muted">
        Papers and preprints in AI for music. Author names are listed as published;{' '}
        <span class="font-medium text-foreground">{SITE.name}</span> is shown in bold. Expand any entry for its
        abstract and a copy-ready BibTeX citation. Also on{' '}
        <a href={SITE.social.scholar} class="text-accent-blue underline underline-offset-4 hover:text-foreground">Google Scholar</a>.
      </p>
      <p class="mt-3 font-mono text-xs text-muted">
        {publications.length} ent{publications.length === 1 ? 'ry' : 'ries'} · updated {
          new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
        }
      </p>
    </header>

    <div class="mt-8">
      <FilterBar client:load groups={filterGroups} targetSelector="#publication-list" />
    </div>

    <div id="publication-list" class="space-y-4">
      {publications.map((publication) => <PublicationCard {publication} />)}
    </div>
  </div>
</BaseLayout>
