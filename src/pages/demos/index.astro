---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoCard from '../../components/DemoCard.astro';

const demos = (await getCollection('demos')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Demos"
  description="Static research demos and interactive presentations of music-AI systems — transcription, evaluation, visualization, and generation ranking."
>
  <div class="mx-auto max-w-5xl px-5 py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Research demos</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted">
      Visual walkthroughs and interactive presentations of my research systems — a way to see and hear what the
      methods do, not a hosted model service.
    </p>

    <!-- Honesty banner: no live inference -->
    <div class="mt-6 flex items-start gap-3 rounded-xl border border-accent-blue/30 bg-accent-blue/5 p-4 text-sm leading-relaxed text-muted">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <line x1="12" y1="11" x2="12" y2="16" stroke-linecap="round"></line>
        <circle cx="12" cy="8" r="0.6" fill="currentColor" stroke="none"></circle>
      </svg>
      <p>
        These are <span class="font-medium text-foreground">static demos</span>: each page uses pre-rendered
        examples. They do not run live model inference in your browser.
        Where a system exists, the demo links out to its code and project page.
      </p>
    </div>

    {
      demos.length === 0 ? (
        <p class="mt-10 rounded-lg border border-border bg-card/60 p-6 text-sm text-muted">No demos yet — check back soon.</p>
      ) : (
        <div class="mt-10 grid gap-5 sm:grid-cols-2">
          {demos.map((demo) => <DemoCard {demo} />)}
        </div>
      )
    }
  </div>
</BaseLayout>
