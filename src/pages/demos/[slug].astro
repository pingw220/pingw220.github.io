---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Tag from '../../components/Tag.astro';

export async function getStaticPaths() {
  const demos = await getCollection('demos');
  return demos.map((demo) => ({ params: { slug: demo.id }, props: { demo } }));
}

const { demo } = Astro.props;
const { title, subtitle, description, tags, media, links } = demo.data;
const { Content } = await render(demo);

const linkEntries = [
  { label: 'GitHub ↗', href: links.github },
  { label: 'Paper ↗', href: links.paper },
  { label: 'Project page', href: links.project },
].filter((l): l is { label: string; href: string } => Boolean(l.href));
---

<BaseLayout title={title} description={description} type="article">
  <article class="mx-auto max-w-3xl px-5 py-16">
    <a href="/demos" class="text-sm text-muted transition-colors hover:text-accent-violet">← All demos</a>

    <header class="mt-6">
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-accent-blue/40 px-2.5 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-accent-blue"
      >
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent-blue" aria-hidden="true"></span>
        Static research demo
      </span>
      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
      {subtitle && <p class="mt-2 text-lg text-accent-violet">{subtitle}</p>}
      <p class="mt-4 leading-relaxed text-muted">{description}</p>

      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Topics">
            {tags.map((tag) => (
              <li>
                <Tag label={tag} />
              </li>
            ))}
          </ul>
        )
      }

      {
        linkEntries.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-3">
            {linkEntries.map(({ label, href }) => (
              <Button href={href} variant="secondary" external={href.startsWith('http')}>
                {label}
              </Button>
            ))}
          </div>
        )
      }
    </header>

    {
      media.length > 0 && (
        <section class="mt-10 space-y-4" aria-label="Demo media">
          {media.map((item) => (
            <figure class="rounded-xl border border-border bg-card p-4">
              {item.label && (
                <figcaption class="mb-3 flex flex-wrap items-center gap-2 text-sm font-medium">
                  {item.label}
                  {item.src.includes('placeholder') && (
                    <span class="rounded border border-border px-1.5 py-0.5 font-mono text-[0.6rem] uppercase tracking-wider text-muted">
                      Placeholder
                    </span>
                  )}
                </figcaption>
              )}
              {item.kind === 'audio' && <audio controls preload="none" src={item.src} class="w-full" />}
              {item.kind === 'image' && <img src={item.src} alt={item.label ?? ''} class="w-full rounded-lg" loading="lazy" />}
              {item.kind === 'midi' && (
                <a href={item.src} download class="text-sm font-medium text-accent-violet hover:underline">
                  Download MIDI file ↓
                </a>
              )}
            </figure>
          ))}
        </section>
      )
    }

    <div class="prose prose-invert prose-site mt-10 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
