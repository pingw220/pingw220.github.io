---
import { render, type CollectionEntry } from 'astro:content';
import 'katex/dist/katex.min.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import { formatDate, getLang, localizePath, t } from '../i18n';

interface Props {
  post: CollectionEntry<'posts'>;
}

const lang = getLang(Astro.url);
const ui = t(lang);
const { post } = Astro.props;
const { title, description, date, updated, tags, cover } = post.data;
const { Content } = await render(post);
---

<BaseLayout {title} {description} type="article">
  <article class="mx-auto max-w-3xl px-5 py-16">
    <a href={localizePath('/posts', lang)} class="text-sm text-muted transition-colors hover:text-accent-violet">
      {ui['posts.all']}
    </a>

    <header class="mt-6">
      <p class="font-mono text-xs text-muted">
        <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, lang, 'long')}</time>
        {
          updated && (
            <>
              {` · ${ui['posts.updated']} `}
              <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated, lang, 'long')}</time>
            </>
          )
        }
      </p>
      <h1 class="mt-3 text-3xl font-bold leading-tight tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg leading-relaxed text-muted">{description}</p>
      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2" aria-label={ui['filter.topic']}>
            {tags.map((tag) => (
              <li>
                <Tag label={tag} />
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {cover && <img src={cover} alt="" class="mt-10 w-full rounded-xl border border-border" />}

    <div class="prose prose-site mt-10 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
