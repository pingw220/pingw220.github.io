---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import { SITE } from '../config/site';
import { renderMarkdown } from '../i18n/markdown';
import {
  EDUCATION,
  INDUSTRY_EXPERIENCE,
  RESEARCH_EXPERIENCE,
  RESEARCH_INTERESTS,
  SKILLS,
  type Entry,
} from '../config/cv';
import { getLang, localizePath, t, tr } from '../i18n';

const lang = getLang(Astro.url);
const ui = t(lang);

const sections: { id: string; title: string; entries: Entry[] }[] = [
  { id: 'education', title: ui['about.education'], entries: EDUCATION },
  { id: 'research', title: ui['about.research'], entries: RESEARCH_EXPERIENCE },
  { id: 'industry', title: ui['about.industry'], entries: INDUSTRY_EXPERIENCE },
];

const description =
  lang === 'zh'
    ? '關於王平：華盛頓大學大學部學生研究員，研究後訓練、多模態學習與音樂 AI，由 Noah A. Smith 教授（華盛頓大學）與楊奕軒教授（臺灣大學）指導。'
    : 'About Ping Wang, an undergraduate researcher at the University of Washington working on post-training, multimodal learning, and AI for music, advised by Prof. Noah A. Smith (UW) and Prof. Yi-Hsuan Yang (NTU).';
---

<BaseLayout title={ui['about.title']} {description}>
  <div class="mx-auto max-w-4xl px-5 py-14 sm:py-20">
    <!-- Intro -->
    <div class="grid gap-8 sm:grid-cols-[10rem_1fr] sm:items-start">
      <img
        src={SITE.portrait}
        alt={lang === 'zh' ? `照片：${SITE.name}` : `Portrait of ${SITE.name}`}
        width="160"
        height="160"
        class="h-40 w-40 rounded-2xl border border-border object-cover"
      />
      <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{ui['about.title']}</h1>
        <p class="mt-2 text-muted">{tr(SITE.role, lang)}</p>
        <div class="rich mt-5 space-y-4 leading-relaxed text-foreground/85">
          <Fragment set:html={renderMarkdown(SITE.bio.about[lang], lang)} />
        </div>
        <ProfileLinks class="mt-6" />
      </div>
    </div>

    <!-- Research interests -->
    <section class="mt-16" aria-labelledby="interests">
      <SectionHeading id="interests" title={ui['about.interests']} />
      <ul class="flex flex-wrap gap-2">
        {
          RESEARCH_INTERESTS.map((interest) => (
            <li class="rounded-full border border-border bg-card/60 px-3 py-1 text-sm text-foreground/85">{tr(interest, lang)}</li>
          ))
        }
      </ul>
    </section>

    <!-- Education & experience -->
    {
      sections.map(({ id, title, entries }) => (
        <section class="mt-14" aria-labelledby={id}>
          <SectionHeading {id} {title} />
          <ol class="space-y-8">
            {entries.map((entry) => (
              <li class="rich">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <h3 class="font-semibold text-foreground">
                    {entry.orgHref ? <a href={entry.orgHref}>{tr(entry.org, lang)}</a> : tr(entry.org, lang)}
                  </h3>
                  <span class="text-sm text-muted">{tr(entry.place, lang)}</span>
                </div>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 text-sm">
                  <p class="italic text-foreground/80">
                    {tr(entry.title, lang)}
                    {entry.advisor && tr(entry.advisor.name, lang) && (
                      <>
                        {' '}— {ui['about.advisor']}
                        {lang === 'zh' ? '：' : ': '}
                        <a href={entry.advisor.href}>{tr(entry.advisor.name, lang)}</a>
                      </>
                    )}
                  </p>
                  <span class="font-mono text-xs text-muted">{tr(entry.dates, lang)}</span>
                </div>
                {entry.points && entry.points.length > 0 && (
                  <ul class="mt-3 space-y-2 border-l border-border pl-4 text-sm leading-relaxed text-muted">
                    {entry.points.map((point) => (
                      <li>
                        <span class="font-medium text-foreground">
                          {point.href ? (
                            <a href={localizePath(point.href, lang)}>{tr(point.title, lang)}</a>
                          ) : (
                            tr(point.title, lang)
                          )}
                        </span>
                        {lang === 'zh' ? '：' : ': '}
                        {tr(point.text, lang)}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <!-- Skills -->
    <section class="mt-14" aria-labelledby="skills">
      <SectionHeading id="skills" title={ui['about.skills']} />
      <dl class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-[10rem_1fr]">
        {
          SKILLS.map(({ area, items }) => (
            <>
              <dt class="font-medium text-foreground">{tr(area, lang)}</dt>
              <dd class="leading-relaxed text-muted">{tr(items, lang)}</dd>
            </>
          ))
        }
      </dl>
    </section>
  </div>
</BaseLayout>
