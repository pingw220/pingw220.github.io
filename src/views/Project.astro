---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Tag from '../components/Tag.astro';
import type { Project } from '../i18n/content';
import { getLang, localizePath, t } from '../i18n';

interface Props {
  project: Project;
}

const lang = getLang(Astro.url);
const ui = t(lang);
const { project } = Astro.props;
const { title, subtitle, description, role, year, status, category, tags, links, cover } = project.data;
const { Content } = await render(project);

const linkEntries = [
  { label: 'GitHub ↗', href: links.github },
  { label: `${ui['link.paper']} ↗`, href: links.paper },
  { label: ui['pub.demo'], href: links.demo && localizePath(links.demo, lang) },
  { label: `${ui['link.report']} ↗`, href: links.report },
].filter((l): l is { label: string; href: string } => Boolean(l.href));
---

<BaseLayout {title} {description} type="article">
  <article class="mx-auto max-w-3xl px-5 py-16">
    <a href={localizePath('/research', lang)} class="text-sm text-muted transition-colors hover:text-accent-violet">
      {ui['research.allResearch']}
    </a>

    <header class="mt-6">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-violet">
        {ui[`category.${category}`]} · {year} · {ui[`pstatus.${status}`]}
      </p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
      {subtitle && <p class="mt-2 text-lg text-accent-violet">{subtitle}</p>}
      <p class="mt-4 leading-relaxed text-muted">{description}</p>
      {
        role && (
          <p class="mt-2 text-sm text-muted">
            <span class="font-medium text-foreground">{ui['projects.role']}</span> {role}
          </p>
        )
      }

      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2" aria-label={ui['filter.topic']}>
            {tags.map((tag) => (
              <li>
                <Tag label={tag} />
              </li>
            ))}
          </ul>
        )
      }

      {
        linkEntries.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-3">
            {linkEntries.map(({ label, href }, i) => (
              <Button href={href} variant={i === 0 ? 'primary' : 'secondary'} external={href.startsWith('http')}>
                {label}
              </Button>
            ))}
          </div>
        )
      }
    </header>

    {cover && <img src={cover} alt="" class="mt-10 w-full rounded-xl border border-border" />}

    <div class="prose prose-site mt-10 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
