---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FilterBar from '../components/FilterBar';
import { getLang, t } from '../i18n';
import { getProjects } from '../i18n/content';

const lang = getLang(Astro.url);
const ui = t(lang);

const projects = await getProjects(lang);

const tags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
const years = [...new Set(projects.map((p) => String(p.data.year)))].sort().reverse();

const filterGroups = [
  {
    key: 'category',
    label: ui['filter.type'],
    options: ['research', 'engineering', 'experiment'],
    optionLabels: {
      research: ui['category.research'],
      engineering: ui['category.engineering'],
      experiment: ui['category.experiment'],
    },
  },
  { key: 'tags', label: ui['filter.topic'], options: tags },
  { key: 'year', label: ui['filter.year'], options: years },
];
const filterLabels = { all: ui['filter.all'], none: ui['filter.none'], shown: ui['filter.shown'] };

const description =
  lang === 'zh'
    ? '王平的研究與工程專案：自動採譜、評估、音樂生成與音訊機器學習。'
    : 'Research and engineering projects by Ping Wang: music transcription, evaluation, generation, and audio machine learning.';
---

<BaseLayout title={ui['projects.title']} {description}>
  <div class="mx-auto max-w-5xl px-5 py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{ui['projects.title']}</h1>
    <p class="mt-3 max-w-2xl text-muted">{ui['projects.intro']}</p>

    <div class="mt-10">
      <FilterBar client:load groups={filterGroups} labels={filterLabels} targetSelector="#project-list" />
    </div>

    <div id="project-list" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard {project} />)}
    </div>
  </div>
</BaseLayout>
