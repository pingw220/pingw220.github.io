---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MusicSections from '../components/MusicSections.astro';
import PostCard from '../components/PostCard.astro';
import { LIBRARY, type LibraryShelf } from '../config/library';
import { MUSIC_SECTIONS } from '../config/music';
import { SITE } from '../config/site';
import { formatDate, getLang, localizePath, t, tr } from '../i18n';
import type { PlaygroundData } from '../scripts/playground/types';

const lang = getLang(Astro.url);
const ui = t(lang);

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Stalls along the lane (left/right alternate, entrance first). `world` is where each leads;
// `panel` is its list view.
const STALLS = [
  { world: 'postoffice', panel: 'messages', emoji: '💌', color: '#d62828', side: -1, z: 3 },
  { world: 'studio', panel: 'music', emoji: '🎻', color: '#e76f51', side: 1, z: -2 },
  { world: 'writing', panel: 'posts', emoji: '📝', color: '#2a9d8f', side: -1, z: -7 },
  { world: 'library', panel: 'novels', emoji: '📚', color: '#9b5de5', side: 1, z: -12 },
  { world: 'theater', panel: 'anime', emoji: '🌸', color: '#f15bb5', side: -1, z: -17 },
  { world: 'dramas', panel: 'dramas', emoji: '📺', color: '#2a9d8f', side: 1, z: -22 },
  { world: 'movies', panel: 'movies', emoji: '🎬', color: '#e9c46a', side: -1, z: -27 },
  { world: 'flight', panel: 'travel', emoji: '✈️', color: '#3fa7d6', side: 1, z: -32 },
  { world: 'sports', panel: 'sports', emoji: '🏆', color: '#ffb703', side: -1, z: -37 },
] as const;
const stalls = STALLS.map((s) => ({ ...s, label: ui[`stall.${s.panel}`], blurb: ui[`stall.${s.panel}.blurb`] }));
const shelves: LibraryShelf[] = ['novels', 'anime', 'dramas', 'movies', 'travel', 'sports'];
type Item = (typeof LIBRARY)['novels'][number];
/** Ranked favorites first, then one group per category (in the order they first appear). */
function groupsOf(list: Item[]) {
  const ranked = list.filter((i) => i.rank).sort((a, b) => a.rank! - b.rank!);
  const groups: { title: string; top?: boolean; items: Item[] }[] = [];
  if (ranked.length) groups.push({ title: ui['pg.allTimeTop'].replace('{n}', String(ranked.length)), top: true, items: ranked });
  for (const item of list) {
    if (item.rank) continue;
    const title = item.category ? tr(item.category, lang) : '';
    let g = groups.find((x) => !x.top && x.title === title);
    if (!g) groups.push((g = { title, items: [] }));
    g.items.push(item);
  }
  return groups;
}
// Full dates (YYYY-MM-DD) are formatted; '2025' or '2025-08' are shown as written.
const showDate = (date: string) => (/^\d{4}-\d{2}-\d{2}$/.test(date) ? formatDate(date, lang) : date);

const card = (item: (typeof LIBRARY)['novels'][number]) => ({
  title: tr(item.title, lang),
  subtitle: item.subtitle ? tr(item.subtitle, lang) : undefined,
  note: item.note ? tr(item.note, lang) || undefined : undefined,
  date: item.date ? showDate(item.date) : undefined,
  link: item.link,
  image: item.image,
  imageCredit: item.imageCredit,
  rating: item.rating,
  love: item.love,
  rank: item.rank,
  category: item.category ? tr(item.category, lang) || undefined : undefined,
  review: item.review ? tr(item.review, lang) || undefined : undefined,
  lat: item.lat,
  lon: item.lon,
  home: item.home,
});

const data: PlaygroundData = {
  lang,
  stalls: stalls.map(({ world, label, emoji, color, side, z }) => ({ id: world, label, emoji, color, side, z })),
  music: MUSIC_SECTIONS.map((s) => ({
    title: tr(s.title, lang),
    videos: s.performances.map((p) => ({ id: p.id, title: tr(p.title, lang), detail: tr(p.detail, lang), date: p.date ? formatDate(p.date, lang) : undefined })),
  })),
  novels: LIBRARY.novels.map(card),
  anime: LIBRARY.anime.map(card),
  dramas: (LIBRARY.dramas ?? []).map(card),
  movies: (LIBRARY.movies ?? []).map(card),
  travel: LIBRARY.travel.map(card),
  sports: (LIBRARY.sports ?? []).map(card),
  messagesApi: SITE.visitorApi,
  posts: posts.map((p) => ({ title: p.data.title, description: p.data.description, date: formatDate(p.data.date, lang), href: localizePath(`/posts/${p.id}`, lang) })),
  strings: {
    back: ui['pg.back'],
    nowShowing: ui['pg.nowShowing'],
    moreBooks: ui['pg.moreBooks'],
    moreItems: ui['pg.moreItems'],
    allTimeTop: ui['pg.allTimeTop'],
    cardRank: ui['pg.card.rank'],
    postOffice: ui['pg.postOffice'],
    mailbox: ui['pg.mailbox'],
    noLetters: ui['pg.noLetters'],
    mailboxNote: ui['pg.mailboxNote'],
    comingSoon: ui['pg.comingSoon'],
    mapNote: ui['pg.mapNote'],
    journal: ui['stall.travel'],
    fireworks: ui['pg.fireworks'],
    goats: ui['pg.goats'],
    writingRoom: ui['pg.writingRoom'],
    noPosts: ui['pg.noPosts'],
    writeMessage: ui['pg.writeMessage'],
    messageBoard: ui['pg.messageBoard'],
    beFirst: ui['pg.beFirst'],
    anonymous: ui['pg.anonymous'],
    lookHint: ui['pg.lookHint'],
    cardRating: ui['pg.card.rating'],
    cardLove: ui['pg.card.love'],
    cardCategory: ui['pg.card.category'],
    cardReview: ui['pg.card.review'],
    msgSending: ui['pg.msg.sending'],
    msgSent: ui['pg.msg.sent'],
    msgError: ui['pg.msg.error'],
    msgLimited: ui['pg.msg.limited'],
    msgNone: ui['pg.msg.none'],
    watch: ui['pg.watch'],
    read: ui['pg.read'],
    open: ui['pg.open'],
    prompt: ui['pg.prompt'],
    promptTouch: ui['pg.promptTouch'],
    promptItem: ui['pg.promptItem'],
    promptItemTouch: ui['pg.promptItemTouch'],
    promptExit: ui['pg.promptExit'],
    promptLaunch: ui['pg.promptLaunch'],
    promptLaunchTouch: ui['pg.promptLaunchTouch'],
    promptExitTouch: ui['pg.promptExitTouch'],
    title: ui['pg.title'],
    subtitle: ui['pg.subtitle'],
    helpKeys: ui['pg.helpKeys'],
    helpTouch: ui['pg.helpTouch'],
    helpKeysWorld: ui['pg.helpKeysWorld'],
    helpTouchWorld: ui['pg.helpTouchWorld'],
    ...Object.fromEntries(
      (['postoffice', 'studio', 'writing', 'library', 'theater', 'dramas', 'movies', 'flight', 'sports'] as const).flatMap((w) => [
        [`world.${w}`, ui[`pg.world.${w}`]],
        [`world.${w}.hint`, ui[`pg.world.${w}.hint`]],
      ]),
    ),
  },
};

const description =
  lang === 'zh'
    ? '王平的夜市遊樂場：跟著秋田犬 Joy 逛逛郵局、音樂工作室、書房、圖書館、動畫劇場、影集客廳、電影院、旅行飛機與運動名人堂，最後在盡頭放煙火。'
    : 'Ping Wang’s night-market playground: walk around with Joy the Akita and step into a post office, a music studio, a writing room, a library, an anime theater, a TV lounge, a cinema, an airplane full of travels, and a hall of sports GOATs, then set off fireworks at the end of the lane.';
---

<BaseLayout title={ui['nav.playground']} {description}>
  <!-- 3D playground -->
  <section
    class="market relative h-[calc(100svh-61px)] min-h-[520px] overflow-hidden bg-[#0b0d2e] text-[#fdf4e3]"
    data-market
    data-playground={JSON.stringify(data)}
    data-panels={JSON.stringify(Object.fromEntries(STALLS.map((s) => [s.world, s.panel])))}
    aria-label={ui['pg.title']}
  >
    <div class="market-host absolute inset-0 outline-none" tabindex="0" aria-label={ui['pg.helpKeys']}></div>

    <p class="market-loading pointer-events-none absolute inset-0 flex items-center justify-center text-sm tracking-wide text-[#fdf4e3]/80">
      {ui['pg.loading']}
    </p>

    <div class="pointer-events-none absolute left-3 top-3 max-w-[22rem] rounded-2xl border border-white/10 bg-[#0b0d2e]/65 p-4 shadow-lg backdrop-blur-sm sm:left-5 sm:top-5">
      <h1 class="market-title text-2xl font-bold tracking-tight">🏮 {ui['pg.title']}</h1>
      <p class="market-subtitle mt-1.5 text-sm leading-relaxed text-[#fdf4e3]/85">{ui['pg.subtitle']}</p>
      <p class="market-help mt-2 text-xs leading-relaxed text-[#ffd8a8]">{ui['pg.helpKeys']}</p>
    </div>

    <p
      class="market-greeting pointer-events-none absolute bottom-24 left-1/2 hidden w-max max-w-[90%] -translate-x-1/2 rounded-2xl bg-[#fff3dc] px-4 py-2 text-center text-sm font-medium text-[#4a2c1a] shadow-lg sm:bottom-auto sm:top-6"
      role="status"
    >
      🐶 {ui['pg.greeting']}
    </p>

    <!-- Crosshair (while the mouse is captured) and a hint to capture it -->
    <div class="market-crosshair pointer-events-none absolute left-1/2 top-1/2 hidden h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white/90 shadow-[0_0_6px_rgba(0,0,0,0.6)]" aria-hidden="true"></div>
    <p class="market-lookhint pointer-events-none absolute left-1/2 top-[45%] hidden -translate-x-1/2 rounded-full bg-[#0b0d2e]/70 px-4 py-2 text-sm text-[#fdf4e3] backdrop-blur">
      🖱️ {ui['pg.lookHint']}
    </p>

    <button
      type="button"
      class="market-prompt absolute bottom-24 left-1/2 hidden max-w-[90%] -translate-x-1/2 truncate rounded-full bg-[#fff3dc] px-5 py-2.5 text-sm font-semibold text-[#4a2c1a] shadow-lg transition hover:scale-105"
    >
    </button>

    <!-- Bottom bar: stall buttons in the market; back / list buttons inside a world -->
    <nav aria-label={ui['pg.stalls']} class="absolute inset-x-0 bottom-0 flex gap-2 overflow-x-auto bg-gradient-to-t from-[#0b0d2e]/90 to-transparent px-3 pb-3 pt-8 sm:justify-center">
      <div class="market-bar contents">
        {
          stalls.map((s) => (
            <button
              type="button"
              data-world={s.world}
              class="shrink-0 rounded-full border border-white/15 bg-[#0b0d2e]/70 px-3.5 py-1.5 text-sm text-[#fdf4e3] backdrop-blur transition hover:border-[#ffd8a8] hover:text-[#ffd8a8]"
            >
              {s.emoji} {s.label}
            </button>
          ))
        }
      </div>
      <div class="world-bar hidden gap-2">
        <button type="button" class="world-back shrink-0 rounded-full border border-white/15 bg-[#0b0d2e]/70 px-3.5 py-1.5 text-sm text-[#fdf4e3] backdrop-blur transition hover:border-[#ffd8a8] hover:text-[#ffd8a8]">
          🏮 ← {ui['pg.back']}
        </button>
        <button type="button" class="world-list shrink-0 rounded-full border border-white/15 bg-[#0b0d2e]/70 px-3.5 py-1.5 text-sm text-[#fdf4e3] backdrop-blur transition hover:border-[#ffd8a8] hover:text-[#ffd8a8]">
          ☰ {ui['pg.showList']}
        </button>
      </div>
    </nav>
  </section>

  <!-- List of stalls when 3D isn't available (or reduced motion is preferred) -->
  <section class="market-fallback mx-auto hidden max-w-4xl px-5 py-14" aria-label={ui['pg.stalls']}>
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">🏮 {ui['pg.title']}</h1>
    <p class="mt-3 text-muted">{ui['pg.subtitle']}</p>
    <p class="market-fallback-reason mt-4 rounded-lg border border-border bg-card/60 p-4 text-sm text-muted" data-nogl={ui['pg.fallback']} data-reduced={ui['pg.reducedMotion']}></p>
    <button type="button" class="market-show3d mt-3 hidden text-sm text-accent-blue underline underline-offset-4 hover:text-foreground">
      {ui['pg.show3d']}
    </button>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        stalls.map((s) => (
          <li>
            <button
              type="button"
              data-panel-open={s.panel}
              class="card-hover flex w-full items-start gap-4 rounded-xl border border-border bg-card p-5 text-left"
              style={`border-left: 4px solid ${s.color}`}
            >
              <span class="text-3xl" aria-hidden="true">{s.emoji}</span>
              <span>
                <span class="block font-semibold text-foreground">{s.label}</span>
                <span class="mt-1 block text-sm text-muted">{s.blurb}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Overlays: a backdrop, the per-stall list panels, and a card for single items -->
  <div class="market-backdrop fixed inset-0 z-[60] hidden bg-black/40 backdrop-blur-[2px]"></div>
  {
    stalls.map((s) => (
      <div
        class="market-panel fixed inset-x-0 bottom-0 z-[70] hidden max-h-[86svh] overflow-y-auto rounded-t-3xl border border-border bg-background shadow-2xl sm:inset-y-0 sm:left-auto sm:right-0 sm:max-h-none sm:w-[min(44rem,92vw)] sm:rounded-none sm:rounded-l-3xl"
        data-panel={s.panel}
        role="dialog"
        aria-modal="true"
        aria-labelledby={`panel-${s.panel}`}
      >
        <div class="sticky top-0 z-10 flex items-center justify-between gap-4 border-b border-border bg-background/95 px-6 py-4 backdrop-blur" style={`box-shadow: inset 0 4px 0 ${s.color}`}>
          <div>
            <h2 id={`panel-${s.panel}`} class="text-xl font-semibold tracking-tight">
              <span aria-hidden="true">{s.emoji}</span> {s.label}
            </h2>
            <p class="mt-0.5 text-sm text-muted">{s.blurb}</p>
          </div>
          <button type="button" class="market-close shrink-0 rounded-full border border-border px-3 py-1.5 text-sm text-muted transition-colors hover:border-accent-violet/60 hover:text-foreground">
            {ui['pg.close']} ✕
          </button>
        </div>
        <div class="px-6 py-6">
          {s.panel === 'music' && (
            <>
              <MusicSections compact />
              <a href={localizePath('/music', lang)} class="mt-8 inline-block text-sm text-accent-blue underline underline-offset-4 hover:text-foreground">
                {ui['pg.allMusic']} →
              </a>
            </>
          )}
          {s.panel === 'messages' && (
            <>
              <form class="msg-form space-y-3">
                <label class="block text-sm">
                  <span class="text-muted">{ui['pg.msg.name']}</span>
                  <input name="name" maxlength="40" autocomplete="nickname" class="mt-1 w-full rounded-lg border border-border bg-card px-3 py-2 text-foreground" />
                </label>
                <label class="block text-sm">
                  <span class="text-muted">{ui['pg.msg.message']}</span>
                  <textarea name="message" required maxlength="800" rows="5" class="mt-1 w-full rounded-lg border border-border bg-card px-3 py-2 text-foreground"></textarea>
                </label>
                {/* Honeypot: hidden from people, tempting to bots. */}
                <input name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
                <fieldset class="space-y-1.5 text-sm">
                  <label class="flex items-center gap-2"><input type="radio" name="visibility" value="private" checked /> 🔒 {ui['pg.msg.private']}</label>
                  <label class="flex items-center gap-2"><input type="radio" name="visibility" value="public" /> 📌 {ui['pg.msg.public']}</label>
                </fieldset>
                <div class="flex items-center gap-3">
                  <button type="submit" class="rounded-full bg-accent-violet px-5 py-2 text-sm font-semibold text-background transition hover:brightness-110">💌 {ui['pg.msg.send']}</button>
                  <p class="msg-status text-sm text-muted" role="status"></p>
                </div>
              </form>
              <h3 class="mt-10 text-lg font-semibold">{ui['pg.msg.publicList']}</h3>
              <ul class="msg-list mt-3 space-y-3"></ul>
            </>
          )}
          {s.panel === 'posts' &&
            (posts.length ? (
              <>
                <div class="space-y-4">{posts.map((post) => <PostCard {post} />)}</div>
                <a href={localizePath('/posts', lang)} class="mt-6 inline-block text-sm text-accent-blue underline underline-offset-4 hover:text-foreground">
                  {ui['pg.allPosts']} →
                </a>
              </>
            ) : (
              <p class="rounded-xl border border-dashed border-border p-6 text-sm text-muted">{ui['posts.empty']}</p>
            ))}
          {shelves.includes(s.panel as LibraryShelf) &&
            (LIBRARY[s.panel as LibraryShelf].length ? (
              <div class="space-y-8">
                {groupsOf(LIBRARY[s.panel as LibraryShelf]).map((group) => (
                  <section>
                    {group.title && (
                      <h3 class="mb-3 text-base font-semibold">
                        {group.top ? '🏆 ' : ''}
                        {group.title} <span class="font-normal text-muted">· {group.items.length}</span>
                      </h3>
                    )}
                    <ul class="grid gap-4 sm:grid-cols-2">
                      {group.items.map((item) => (
                        <li class="overflow-hidden rounded-xl border border-border bg-card">
                          {item.image && <img src={item.image} alt="" loading="lazy" class={`w-full object-cover ${s.panel === 'travel' || s.panel === 'sports' ? 'aspect-[4/3]' : 'aspect-[3/4] max-h-80'}`} />}
                          <div class="p-4">
                            <h3 class="font-semibold leading-snug">
                              {item.rank && <span class="mr-1.5 rounded-full bg-[#ffd166] px-2 py-0.5 text-xs font-bold text-[#3a2410]">#{item.rank}</span>}
                              {item.link ? (
                                <a href={item.link} class="hover:text-accent-violet" target="_blank" rel="noopener noreferrer">
                                  {tr(item.title, lang)} ↗
                                </a>
                              ) : (
                                tr(item.title, lang)
                              )}
                            </h3>
                            {(item.subtitle || item.date) && (
                              <p class="mt-1 text-sm text-muted">
                                {item.subtitle && tr(item.subtitle, lang)}
                                {item.subtitle && item.date && ' · '}
                                {item.date && <span class="font-mono text-xs">{showDate(item.date)}</span>}
                              </p>
                            )}
                            {item.note && tr(item.note, lang) && <p class="mt-2 text-sm leading-relaxed text-muted">{tr(item.note, lang)}</p>}
                          </div>
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            ) : (
              <p class="rounded-xl border border-dashed border-border p-6 text-sm text-muted">🌙 {ui['pg.empty']}</p>
            ))}
        </div>
      </div>
    ))
  }

  <div
    class="item-card fixed inset-x-0 bottom-0 z-[70] hidden max-h-[86svh] overflow-y-auto rounded-t-3xl border border-border bg-background shadow-2xl sm:inset-auto sm:left-1/2 sm:top-1/2 sm:w-[min(36rem,92vw)] sm:-translate-x-1/2 sm:-translate-y-1/2 sm:rounded-3xl"
    role="dialog"
    aria-modal="true"
    aria-labelledby="item-card-title"
  >
    <div class="item-media"></div>
    <div class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 id="item-card-title" class="item-title text-xl font-semibold leading-snug tracking-tight"></h2>
          <p class="item-subtitle mt-1 text-sm text-muted"></p>
        </div>
        <button type="button" class="market-close shrink-0 rounded-full border border-border px-3 py-1.5 text-sm text-muted transition-colors hover:border-accent-violet/60 hover:text-foreground">
          {ui['pg.close']} ✕
        </button>
      </div>
      <p class="item-note mt-4 leading-relaxed text-foreground/85"></p>
      <dl class="item-facts mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-sm"></dl>
      <a class="item-credit mt-4 hidden text-xs text-muted underline underline-offset-2 hover:text-foreground" target="_blank" rel="noopener noreferrer"></a>
      <a class="item-link mt-5 hidden text-sm text-accent-blue underline underline-offset-4 hover:text-foreground"></a>
    </div>
  </div>
</BaseLayout>

<script>
  import type { Engine } from '../scripts/playground/engine';
  import type { Interactable, PlaygroundData, WorldId } from '../scripts/playground/types';

  const root = document.querySelector<HTMLElement>('[data-market]')!;
  const host = root.querySelector<HTMLElement>('.market-host')!;
  const loading = root.querySelector<HTMLElement>('.market-loading')!;
  const prompt = root.querySelector<HTMLButtonElement>('.market-prompt')!;
  const greeting = root.querySelector<HTMLElement>('.market-greeting')!;
  const titleEl = root.querySelector<HTMLElement>('.market-title')!;
  const subtitleEl = root.querySelector<HTMLElement>('.market-subtitle')!;
  const help = root.querySelector<HTMLElement>('.market-help')!;
  const marketBar = root.querySelector<HTMLElement>('.market-bar')!;
  const worldBar = root.querySelector<HTMLElement>('.world-bar')!;
  const fallback = document.querySelector<HTMLElement>('.market-fallback')!;
  const fallbackReason = fallback.querySelector<HTMLElement>('.market-fallback-reason')!;
  const show3d = fallback.querySelector<HTMLButtonElement>('.market-show3d')!;
  const backdrop = document.querySelector<HTMLElement>('.market-backdrop')!;
  const itemCard = document.querySelector<HTMLElement>('.item-card')!;
  const data: PlaygroundData = JSON.parse(root.dataset.playground ?? '{}');
  const panelFor: Record<string, string> = JSON.parse(root.dataset.panels ?? '{}');
  const S = data.strings;
  const touch = matchMedia('(pointer: coarse)').matches;
  const WORLDS: WorldId[] = ['market', 'postoffice', 'studio', 'writing', 'library', 'theater', 'dramas', 'movies', 'flight', 'sports'];
  const crosshair = root.querySelector<HTMLElement>('.market-crosshair')!;
  const lookHint = root.querySelector<HTMLElement>('.market-lookhint')!;

  help.textContent = touch ? S.helpTouch : S.helpKeys;

  let engine: Engine | null = null;
  let current: WorldId = 'market';
  let lastStall = '';
  let open: HTMLElement | null = null;
  let lastFocus: HTMLElement | null = null;

  // ── Overlays ────────────────────────────────────────────────────────────
  function show(el: HTMLElement) {
    if (open) hide(false);
    lastFocus = document.activeElement as HTMLElement | null;
    open = el;
    el.classList.remove('hidden');
    backdrop.classList.remove('hidden');
    el.scrollTop = 0;
    el.querySelector<HTMLElement>('.market-close')?.focus();
    engine?.setPaused(true);
    lookHint.classList.add('hidden');
  }
  function hide(restoreFocus = true) {
    if (!open) return;
    open.classList.add('hidden');
    open.querySelectorAll('iframe').forEach((f) => f.remove()); // stop any playing video
    backdrop.classList.add('hidden');
    open = null;
    engine?.setPaused(false);
    if (engine && !touch) lookHint.classList.remove('hidden');
    if (restoreFocus) (lastFocus && document.contains(lastFocus) ? lastFocus : host).focus();
  }
  const openPanel = (panel: string) => {
    const el = document.querySelector<HTMLElement>(`.market-panel[data-panel="${panel}"]`);
    if (el) show(el);
  };
  document.querySelectorAll('.market-close').forEach((b) => b.addEventListener('click', () => hide()));
  backdrop.addEventListener('click', () => hide());
  document.addEventListener('keydown', (e) => e.key === 'Escape' && open && hide());
  document.querySelectorAll<HTMLButtonElement>('[data-panel-open]').forEach((b) => b.addEventListener('click', () => openPanel(b.dataset.panelOpen!)));

  /** Fill and show the item card. */
  type Facts = { rank?: number; rating?: number; love?: number; category?: string; review?: string };
  function showCard(o: { title: string; subtitle?: string; note?: string; media?: HTMLElement | null; link?: { href: string; label: string; external?: boolean }; facts?: Facts; credit?: { text: string; href?: string } }) {
    const facts = itemCard.querySelector<HTMLElement>('.item-facts')!;
    const rows: [string, string][] = [];
    const f = o.facts ?? {};
    if (typeof f.rank === 'number') rows.push([S.cardRank, `🏆 #${f.rank}`]);
    if (typeof f.rating === 'number') rows.push([S.cardRating, `${'★'.repeat(Math.floor(f.rating))}${f.rating % 1 >= 0.5 ? '½' : ''}${'☆'.repeat(Math.max(0, 5 - Math.ceil(f.rating)))} ${f.rating}/5`]);
    if (typeof f.love === 'number') rows.push([S.cardLove, '♥'.repeat(Math.round(f.love)) + '♡'.repeat(Math.max(0, 5 - Math.round(f.love)))]);
    if (f.category) rows.push([S.cardCategory, f.category]);
    if (f.review) rows.push([S.cardReview, f.review]);
    facts.replaceChildren(
      ...rows.flatMap(([k, v]) => {
        const dt = document.createElement('dt');
        dt.className = 'font-medium text-muted';
        dt.textContent = k;
        const dd = document.createElement('dd');
        dd.className = 'whitespace-pre-line text-foreground/90';
        dd.textContent = v;
        return [dt, dd];
      }),
    );
    facts.classList.toggle('hidden', rows.length === 0);
    const credit = itemCard.querySelector<HTMLAnchorElement>('.item-credit')!;
    credit.classList.toggle('hidden', !o.credit);
    credit.classList.toggle('block', !!o.credit);
    if (o.credit) {
      credit.textContent = o.credit.text;
      if (o.credit.href) credit.href = o.credit.href;
      else credit.removeAttribute('href');
    }
    itemCard.querySelector('.item-title')!.textContent = o.title;
    itemCard.querySelector('.item-subtitle')!.textContent = o.subtitle ?? '';
    const note = itemCard.querySelector<HTMLElement>('.item-note')!;
    note.textContent = o.note ?? '';
    note.classList.toggle('hidden', !o.note);
    itemCard.querySelector('.item-media')!.replaceChildren(...(o.media ? [o.media] : []));
    const link = itemCard.querySelector<HTMLAnchorElement>('.item-link')!;
    link.classList.toggle('hidden', !o.link);
    link.classList.toggle('inline-block', !!o.link);
    if (o.link) {
      link.href = o.link.href;
      link.textContent = `${o.link.label} ${o.link.external ? '↗' : '→'}`;
      if (o.link.external) {
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      } else link.removeAttribute('target');
    }
    show(itemCard);
  }
  function youtube(id: string, title: string) {
    const box = document.createElement('div');
    box.className = 'relative aspect-video w-full overflow-hidden rounded-t-3xl bg-black';
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
    iframe.title = title;
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.className = 'absolute inset-0 h-full w-full';
    box.append(iframe);
    return box;
  }
  function image(src?: string) {
    if (!src) return null;
    const img = document.createElement('img');
    img.src = src;
    img.alt = '';
    img.className = 'aspect-[4/3] w-full rounded-t-3xl object-cover';
    return img;
  }
  const meta = (...parts: (string | undefined)[]) => parts.filter(Boolean).join(' · ');

  const shelfOf: Record<string, () => PlaygroundData['novels']> = {
    book: () => data.novels,
    anime: () => data.anime,
    drama: () => data.dramas,
    movie: () => data.movies,
    place: () => data.travel,
    athlete: () => data.sports,
  };
  function openItem(item: Interactable) {
    const [kind, raw] = item.id.split(':');
    const i = Number(raw);
    if (kind === 'video') {
      const video = data.music.flatMap((s) => s.videos.map((v) => ({ ...v, section: s.title }))).find((v) => v.id === raw);
      if (video) showCard({ title: video.title, subtitle: meta(video.detail, video.date), media: youtube(video.id, video.title), link: { href: `https://www.youtube.com/watch?v=${video.id}`, label: S.watch, external: true } });
    } else if (kind in shelfOf) {
      const c = shelfOf[kind]()[i];
      if (c)
        showCard({
          title: `${kind === 'place' ? (c.home ? '🏠 ' : '📍 ') : ''}${c.title}`,
          subtitle: meta(c.subtitle, c.date),
          note: c.note,
          media: image(c.image),
          link: c.link ? { href: c.link, label: S.open, external: true } : undefined,
          facts: { rank: c.rank, rating: c.rating, love: c.love, category: c.category, review: c.review },
          credit: c.imageCredit,
        });
    } else if (kind === 'msg') {
      const m = messages.find((x) => String(x.id) === raw);
      if (m) showCard({ title: `💌 ${m.name || S.anonymous}`, subtitle: new Date(m.date).toLocaleDateString(data.lang === 'zh' ? 'zh-Hant-TW' : 'en-US'), note: m.message });
    } else if (kind === 'post') {
      const p = data.posts[i];
      if (p) showCard({ title: p.title, subtitle: p.date, note: p.description, link: { href: p.href, label: S.read } });
    }
  }

  // ── World UI ────────────────────────────────────────────────────────────
  function onWorldChange(world: WorldId) {
    current = world;
    const inMarket = world === 'market';
    marketBar.classList.toggle('hidden', !inMarket);
    marketBar.classList.toggle('contents', inMarket);
    worldBar.classList.toggle('hidden', inMarket);
    worldBar.classList.toggle('flex', !inMarket);
    const stall = data.stalls.find((s) => s.id === world);
    titleEl.textContent = inMarket ? `🏮 ${S.title}` : `${stall?.emoji ?? ''} ${S[`world.${world}`]}`;
    subtitleEl.textContent = inMarket ? S.subtitle : S[`world.${world}.hint`];
    help.textContent = inMarket ? (touch ? S.helpTouch : S.helpKeys) : touch ? S.helpTouchWorld : S.helpKeysWorld;
    const hash = inMarket ? '' : `#${world}`;
    if (location.hash !== hash) history.replaceState(null, '', `${location.pathname}${location.search}${hash}`);
  }

  let nearItem: Interactable | null = null;
  function onNear(item: Interactable | null) {
    nearItem = item;
    if (!item) return prompt.classList.add('hidden');
    const action =
      item.kind === 'enter'
        ? touch ? S.promptTouch : S.prompt
        : item.kind === 'exit'
          ? touch ? S.promptExitTouch : S.promptExit
          : item.activate
            ? touch ? S.promptLaunchTouch : S.promptLaunch
            : touch ? S.promptItemTouch : S.promptItem;
    prompt.textContent = `${item.emoji ?? ''} ${item.label} · ${action}`;
    prompt.classList.remove('hidden');
  }
  function onActivate(item: Interactable) {
    if (item.kind === 'station') {
      if (item.id === 'mailbox') {
        openPanel('messages');
        document.querySelector<HTMLTextAreaElement>('.msg-form textarea')?.focus();
      } else openPanel(panelFor[current]);
      return;
    }
    if (item.kind === 'enter') {
      lastStall = item.id;
      engine?.enter(item.id as WorldId);
    } else if (item.kind === 'exit') engine?.enter('market', lastStall || current);
    else openItem(item);
  }
  prompt.addEventListener('click', () => nearItem && onActivate(nearItem));

  marketBar.querySelectorAll<HTMLButtonElement>('[data-world]').forEach((b) =>
    b.addEventListener('click', () => {
      engine?.visit(b.dataset.world!);
      host.focus();
    }),
  );
  worldBar.querySelector('.world-back')!.addEventListener('click', () => {
    engine?.enter('market', lastStall || current);
    host.focus();
  });
  worldBar.querySelector('.world-list')!.addEventListener('click', () => openPanel(panelFor[current]));
  window.addEventListener('hashchange', () => {
    const w = location.hash.slice(1) as WorldId;
    if (engine && WORLDS.includes(w) && w !== current) {
      if (w !== 'market') lastStall = w;
      engine.enter(w);
    }
  });

  // ── Guestbook ───────────────────────────────────────────────────────────
  type Message = { id: number; name: string; message: string; date: string };
  let messages: Message[] = [];
  const msgList = document.querySelector<HTMLElement>('.msg-list');
  const api = (data.messagesApi || '').replace(/\/$/, '');
  function renderMessages() {
    (window as { playgroundMessages?: Message[] }).playgroundMessages = messages;
    window.dispatchEvent(new CustomEvent('playground:messages', { detail: messages }));
    if (!msgList) return;
    if (!messages.length) {
      const li = document.createElement('li');
      li.className = 'rounded-xl border border-dashed border-border p-4 text-sm text-muted';
      li.textContent = S.msgNone;
      return msgList.replaceChildren(li);
    }
    msgList.replaceChildren(
      ...messages.map((m) => {
        const li = document.createElement('li');
        li.className = 'rounded-xl border border-border bg-card p-4';
        const head = document.createElement('p');
        head.className = 'text-sm font-semibold';
        head.textContent = `💌 ${m.name || S.anonymous}`;
        const when = document.createElement('span');
        when.className = 'ml-2 font-mono text-xs font-normal text-muted';
        when.textContent = new Date(m.date).toLocaleDateString(data.lang === 'zh' ? 'zh-Hant-TW' : 'en-US');
        head.append(when);
        const body = document.createElement('p');
        body.className = 'mt-1 whitespace-pre-line text-sm leading-relaxed text-foreground/85';
        body.textContent = m.message;
        li.append(head, body);
        return li;
      }),
    );
  }
  async function loadMessages() {
    if (!api) return renderMessages();
    try {
      const res = await fetch(`${api}/messages`);
      if (res.ok) messages = (await res.json()).messages ?? [];
    } catch {}
    renderMessages();
  }
  document.querySelector<HTMLFormElement>('.msg-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const status = form.querySelector<HTMLElement>('.msg-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const fd = new FormData(form);
    button.disabled = true;
    status.textContent = S.msgSending;
    try {
      const res = await fetch(`${api}/messages`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: fd.get('name'), message: fd.get('message'), public: fd.get('visibility') === 'public', website: fd.get('website') }),
      });
      const out = await res.json().catch(() => ({}));
      if (out.ok) {
        status.textContent = S.msgSent;
        form.reset();
        loadMessages();
      } else status.textContent = out.error === 'rate limited' ? S.msgLimited : S.msgError;
    } catch {
      status.textContent = S.msgError;
    }
    button.disabled = false;
  });
  loadMessages();

  // ── Start ───────────────────────────────────────────────────────────────
  function hasWebGL() {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }
  function showFallback(reason: 'nogl' | 'reduced') {
    root.classList.add('hidden');
    fallback.classList.remove('hidden');
    fallbackReason.textContent = (reason === 'nogl' ? fallbackReason.dataset.nogl : fallbackReason.dataset.reduced) ?? '';
    show3d.classList.toggle('hidden', reason !== 'reduced');
  }
  async function start3d() {
    root.classList.remove('hidden');
    fallback.classList.add('hidden');
    try {
      const [{ startEngine }, { marketWorld }, { studioWorld }, { writingWorld }, { libraryWorld }, { theaterWorld }, { dramasWorld, moviesWorld }, { flightWorld }, { sportsWorld }, { postOfficeWorld }] =
        await Promise.all([
          import('../scripts/playground/engine'),
          import('../scripts/playground/worlds/market'),
          import('../scripts/playground/worlds/studio'),
          import('../scripts/playground/worlds/writing'),
          import('../scripts/playground/worlds/library'),
          import('../scripts/playground/worlds/theater'),
          import('../scripts/playground/worlds/screens'),
          import('../scripts/playground/worlds/flight'),
          import('../scripts/playground/worlds/sports'),
          import('../scripts/playground/worlds/postoffice'),
        ]);
      const fromHash = location.hash.slice(1) as WorldId;
      const first = WORLDS.includes(fromHash) ? fromHash : 'market';
      if (first !== 'market') lastStall = first;
      engine = startEngine(
        host,
        {
          worlds: {
            market: marketWorld(data),
            studio: studioWorld(data),
            writing: writingWorld(data),
            library: libraryWorld(data),
            theater: theaterWorld(data),
            dramas: dramasWorld(data),
            movies: moviesWorld(data),
            flight: flightWorld(data),
            sports: sportsWorld(data),
            postoffice: postOfficeWorld(data),
          },
          onNear,
          onActivate,
          onWorldChange,
          onLookChange(locked) {
            crosshair.classList.toggle('hidden', !locked);
            lookHint.classList.toggle('hidden', locked || touch || !!open);
          },
        },
        first,
      );
      requestAnimationFrame(() => loading.remove());
      if (!touch) lookHint.classList.remove('hidden');
      renderMessages();
      host.focus({ preventScroll: true });
      if (first === 'market') {
        greeting.classList.remove('hidden');
        setTimeout(() => greeting.classList.add('hidden'), 5000);
      }
    } catch (err) {
      console.error(err);
      showFallback('nogl');
    }
  }
  show3d.addEventListener('click', start3d);

  if (!hasWebGL()) showFallback('nogl');
  else if (matchMedia('(prefers-reduced-motion: reduce)').matches) showFallback('reduced');
  else start3d();
</script>
