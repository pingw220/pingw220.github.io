---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import FilterBar from '../components/FilterBar';
import { SITE } from '../config/site';
import { HTML_LANG, getLang, t } from '../i18n';

const lang = getLang(Astro.url);
const ui = t(lang);

const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);

const tags = [...new Set(publications.flatMap((p) => p.data.tags))].sort();
const years = [...new Set(publications.map((p) => String(p.data.year)))].sort().reverse();
const statuses = [...new Set(publications.map((p) => p.data.status))];

const filterGroups = [
  { key: 'tags', label: ui['filter.topic'], options: tags },
  { key: 'year', label: ui['filter.year'], options: years },
  {
    key: 'status',
    label: ui['filter.status'],
    options: statuses,
    optionLabels: Object.fromEntries(statuses.map((st) => [st, ui[`status.${st}`]])),
  },
];
const filterLabels = { all: ui['filter.all'], none: ui['filter.none'], shown: ui['filter.shown'] };

const description =
  lang === 'zh'
    ? '王平的論文：自動採譜與其評估、音樂生成的後訓練。'
    : 'Publications by Ping Wang on automatic music transcription, its evaluation, and post-training for music generation.';
---

<BaseLayout title={ui['pubs.title']} {description}>
  <div class="mx-auto max-w-3xl px-5 py-16">
    <header class="border-b border-border pb-6">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{ui['pubs.title']}</h1>
      <p class="mt-3 leading-relaxed text-muted">
        {ui['pubs.intro.before']}{' '}
        <span class="font-medium text-foreground">{SITE.name}</span>
        {' '}{ui['pubs.intro.after']}{' '}
        <a href={SITE.social.scholar} class="text-accent-blue underline underline-offset-4 hover:text-foreground">Google Scholar</a>{lang === 'zh' ? '。' : '.'}
      </p>
      <p class="mt-3 font-mono text-xs text-muted">
        {ui['pubs.count'](publications.length)} · {ui['pubs.updated']}{' '}
        {new Date().toLocaleDateString(HTML_LANG[lang], { month: 'long', year: 'numeric' })}
      </p>
    </header>

    <div class="mt-8">
      <FilterBar client:load groups={filterGroups} labels={filterLabels} targetSelector="#publication-list" />
    </div>

    <div id="publication-list" class="space-y-4">
      {publications.map((publication) => <PublicationCard {publication} />)}
    </div>
  </div>
</BaseLayout>
