---
/**
 * One Interests topic on its own themed page (library, theater, TV lounge, cinema, travel map,
 * hall of fame, post office). Items open a detail card.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Guestbook from '../components/interests/Guestbook.astro';
import ItemDialog from '../components/interests/ItemDialog.astro';
import Cinema from '../components/interests/topics/Cinema.astro';
import Hall from '../components/interests/topics/Hall.astro';
import Library from '../components/interests/topics/Library.astro';
import Lounge from '../components/interests/topics/Lounge.astro';
import Theater from '../components/interests/topics/Theater.astro';
import TravelMap from '../components/interests/topics/TravelMap.astro';
import { TOPICS, type Topic } from '../config/interests';
import { LIBRARY, type LibraryItem } from '../config/library';
import { getCollection } from 'astro:content';
import { formatDate, getLang, localizePath, t, tr } from '../i18n';

interface Props {
  id: Topic['id'];
}

const lang = getLang(Astro.url);
const ui = t(lang);
const topic = TOPICS.find((x) => x.id === Astro.props.id)!;
const label = ui[`stall.${topic.key}`];
const blurb = ui[`stall.${topic.key}.blurb`];
const items: LibraryItem[] =
  topic.id === 'novels' ? LIBRARY.novels : topic.id === 'anime' ? LIBRARY.anime : topic.id === 'dramas' ? (LIBRARY.dramas ?? []) : topic.id === 'movies' ? (LIBRARY.movies ?? []) : topic.id === 'travel' ? LIBRARY.travel : topic.id === 'sports' ? (LIBRARY.sports ?? []) : [];
// Travel journals: posts that name places from the travel list.
const journalPosts = topic.id === 'travel' ? (await getCollection('posts', ({ data }) => !data.draft && data.places.length > 0)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()) : [];
const journals = journalPosts.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  href: localizePath(`/posts/${p.id}`, lang),
  date: formatDate(p.data.date, lang),
  cover: p.data.cover,
  places: p.data.places,
}));
const related = journals.flatMap((j) =>
  j.places.flatMap((place) => {
    const index = items.findIndex((it) => [tr(it.title, 'en'), tr(it.title, 'zh')].some((n) => n.toLowerCase() === place.toLowerCase()));
    return index >= 0 ? [{ index, title: j.title, href: j.href }] : [];
  }),
);
// Previous / next topic pages, for wandering from one to the next.
const pages = TOPICS.filter((x) => !x.href);
const at = pages.findIndex((x) => x.id === topic.id);
const prev = pages[(at - 1 + pages.length) % pages.length];
const next = pages[(at + 1) % pages.length];
const hrefOf = (x: Topic) => localizePath(`/interests/${x.id}`, lang);
---

<BaseLayout title={label} description={blurb}>
  <div class="mx-auto max-w-6xl px-5 pb-20 pt-8 sm:pt-10">
    <nav class="mb-8 flex items-center justify-between gap-4 text-sm">
      <a href={localizePath('/interests', lang)} class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-3.5 py-1.5 text-muted transition hover:text-foreground">← {ui['int.title']}</a>
      <span class="flex gap-2">
        <a href={hrefOf(prev)} class="rounded-full border border-border bg-card px-3 py-1.5 text-muted transition hover:text-foreground" aria-label={ui[`stall.${prev.key}`]}>‹ {prev.emoji}</a>
        <a href={hrefOf(next)} class="rounded-full border border-border bg-card px-3 py-1.5 text-muted transition hover:text-foreground" aria-label={ui[`stall.${next.key}`]}>{next.emoji} ›</a>
      </span>
    </nav>

    <header class="mb-10 flex items-center gap-5">
      <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-3xl text-4xl shadow-lg" style={`background: linear-gradient(140deg, ${topic.colors[0]}, ${topic.colors[1]})`} aria-hidden="true">{topic.emoji}</span>
      <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{label}</h1>
        <p class="mt-1 text-muted">{blurb}</p>
      </div>
    </header>

    {topic.id === 'novels' && <Library {items} />}
    {topic.id === 'anime' && <Theater {items} marquee={ui['int.theater.marquee']} />}
    {topic.id === 'dramas' && <Lounge {items} />}
    {topic.id === 'movies' && <Cinema {items} />}
    {topic.id === 'travel' && <TravelMap {items} {journals} />}
    {topic.id === 'sports' && <Hall {items} />}
    {topic.id === 'guestbook' && <Guestbook variant="postcard" />}

    {items.length > 0 && <p class="mt-8 text-center text-xs text-muted">{ui['int.clickHint']}</p>}
  </div>
  {items.length > 0 && <ItemDialog {items} {related} />}
</BaseLayout>
